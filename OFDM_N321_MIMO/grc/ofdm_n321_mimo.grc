- name: e1_tx
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E1] MIMO OFDM TX source  (g\u1ED1c: ofdm321/blocks.py::MimoTxSource\
      \ + runner.py::Encoder)\n\n* \u0110\u1ECDc MPEG-TS t\u1EEB ts_path (file ho\u1EB7\
      c FIFO do FFmpeg ghi), c\u1EAFt 188 B, \u0111\xF3ng g\xF3i DATA (header 24 B\n\
      \  'OVN1', y h\u1EC7t N210 v1.23), sau m\u1ED7i 8 DATA th\xEAm 8 RS8_PARITY,\
      \ h\u1EBFt file th\xEC g\u1EEDi 12 END.\n* M\u1ED7i g\xF3i 212 B -> CRC32 ->\
      \ RS(248,216) -> scramble -> khung OFDM c\u1EE7a modem.Modulator:\n  STF (CSD\
      \ tr\xEAn TX1) + 2 LTF ma tr\u1EADn P + SIG + payload; ch\u1EBF \u0111\u1ED9\
      \ siso/simo/alamouti/smux.\n* 2 \u0111\u1EA7u ra = 2 k\xEAnh TX (A:0, B:0).\
      \ C\xE1c ch\u1EBF \u0111\u1ED9 1 TX \u0111\u1EC3 k\xEAnh B b\u1EB1ng 0.\n* Khi\
      \ h\xE0ng \u0111\u1EE3i r\u1ED7ng: ph\xE1t khung IDLE d\u1EF1ng s\u1EB5n (lu\u1ED3\
      ng RF li\xEAn t\u1EE5c, g\u1EA7n nh\u01B0 kh\xF4ng t\u1ED1n CPU).\n* throttle=True\
      \ ch\u1EC9 d\xF9ng cho ch\u1EBF \u0111\u1ED9 m\xF4 ph\u1ECFng (kh\xF4ng c\xF3\
      \ UHD \u0111\u1EC3 \u0111i\u1EC1u nh\u1ECBp).\n\"\"\"\nimport os\nimport sys\n\
      import numpy as np\nfrom gnuradio import gr\n\n\ndef _project_root():\n    \"\
      \"\"Find the OFDM_N321_MIMO folder that contains the ofdm321 package.\"\"\"\n\
      \    here = globals().get(\"__file__\")\n    candidates = [os.environ.get(\"\
      OFDM_N321_DIR\", \"\")]\n    if here:\n        d = os.path.dirname(os.path.abspath(here))\n\
      \        candidates += [d, os.path.dirname(d)]\n    candidates.append(os.path.expanduser(\"\
      ~/Desktop/OFDM_N321_MIMO\"))\n    for c in candidates:\n        if c and os.path.isfile(os.path.join(c,\
      \ \"ofdm321\", \"__init__.py\")):\n            c = os.path.abspath(c)\n    \
      \        if c not in sys.path:\n                sys.path.insert(0, c)\n    \
      \        return c\n    return None\n\n\ndef _settings(**kw):\n    from ofdm321.config\
      \ import load_settings\n    return load_settings(None, **kw)\n\n\ndef _missing(title,\
      \ in_sig, out_sig, msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321: \u0111\u1EB7t .grc trong OFDM_N321_MIMO/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c project>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\nimport threading\nimport time\n\
      \n\ndef _base():\n    if _project_root():\n        try:\n            from ofdm321.blocks\
      \ import MimoTxSource as B\n            return B\n        except Exception as\
      \ exc:  # noqa: BLE001\n            print(\"[E1] import l\u1ED7i:\", exc)\n\
      \    return _missing(\"MIMO TX source\", None, [np.complex64, np.complex64])\n\
      \n\nclass blk(_base()):\n    \"\"\"MIMO OFDM TX source + b\u1ED9 n\u1EA1p TS/FEC.\"\
      \"\"\n\n    def __init__(self, mimo_mode=\"alamouti\", modulation=\"qpsk\",\
      \ sample_rate=1000000,\n                 tx_rms=0.1, session=0x4E333231, ts_path=\"\
      \", throttle=False):\n        super().__init__(_settings(mimo_mode=mimo_mode,\
      \ modulation=modulation,\n                                   sample_rate=float(sample_rate),\
      \ tx_rms=float(tx_rms)),\n                         int(session), bool(throttle))\n\
      \        self.session_id, self.ts_path = int(session), ts_path\n        self._stop\
      \ = threading.Event()\n\n    def start(self):\n        threading.Thread(target=self._feed,\
      \ daemon=True).start()\n        return True\n\n    def stop(self):\n       \
      \ self._stop.set()\n        print(\"[E1]\", self.snapshot())\n        return\
      \ True\n\n    def _feed(self):\n        from ofdm321 import protocol\n     \
      \   from ofdm321.fec_rs import encode_parity\n        if not self.ts_path:\n\
      \            print(\"[E1] ts_path tr\u1ED1ng: ch\u1EC9 ph\xE1t IDLE\")\n   \
      \         return\n        seq, group = 0, []\n\n        def parity(g):\n   \
      \         for i, p in enumerate(encode_parity(g, 8)):\n                self.enqueue(protocol.pack_packet(protocol.RS8_PARITY,\
      \ self.session_id, seq - len(g), p,\n                                      \
      \            protocol.rs_parity_stamp(len(g), i, 8)), self._stop)\n        with\
      \ open(os.path.expanduser(self.ts_path), \"rb\") as f:\n            while not\
      \ self._stop.is_set():\n                chunk = f.read(188)\n              \
      \  if len(chunk) < 188:\n                    break\n                self.enqueue(protocol.pack_packet(protocol.DATA,\
      \ self.session_id, seq, chunk,\n                                           \
      \       time.monotonic_ns()), self._stop)\n                seq += 1\n      \
      \          group.append(chunk)\n                if len(group) == 8:\n      \
      \              parity(group)\n                    group = []\n        if group:\n\
      \            parity(group)\n        for _ in range(12):\n            self.enqueue(protocol.pack_packet(protocol.END,\
      \ self.session_id, seq), self._stop)\n        print(\"[E1] \u0111\xE3 n\u1EA1\
      p h\u1EBFt TS, DATA =\", seq)\n"
    affinity: ''
    alias: ''
    comment: "[E1] g\xF3i -> khung OFDM MIMO (2 lu\u1ED3ng)"
    maxoutbuf: '0'
    mimo_mode: mimo_mode
    minoutbuf: '0'
    modulation: modulation
    sample_rate: samp_rate
    session: session
    throttle: 'False'
    ts_path: ts_path
    tx_rms: tx_rms
  states:
    _io_cache: "('MIMO OFDM TX source', 'blk', [('mimo_mode', \"'alamouti'\"), ('modulation',\
      \ \"'qpsk'\"), ('sample_rate', '1000000'), ('tx_rms', '0.1'), ('session', '1311978033'),\
      \ ('ts_path', \"''\"), ('throttle', 'False')], [], [('0', 'complex', 1), ('1',\
      \ 'complex', 1)], 'MIMO OFDM TX source + b\u1ED9 n\u1EA1p TS/FEC.', ['throttle',\
      \ 'ts_path'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 380]
    rotation: 0
    state: enabled
- name: e2_rx
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E2] MIMO OFDM RX  (g\u1ED1c: ofdm321/blocks.py::MimoRxSink\
      \ + modem.Demodulator)\n\n2 \u0111\u1EA7u v\xE0o = RX2 c\u1EE7a A:0 v\xE0 B:0.\
      \ Ring buffer; Schmidl-Cox g\u1ED9p 2 anten (metric chu\u1EA9n ho\xE1\nCauchy-Schwarz)\
      \ -> kho\xE1 khung -> tracking, gi\u1EA3i \u0111i\u1EC1u ch\u1EBF theo l\xF4\
      \ t\u1ED1i \u0111a 16 khung:\nFFT -> H(k) 2x2 t\u1EEB LTF ma tr\u1EADn P ->\
      \ SIG (CRC16) -> b\xF9 pha chung b\u1EB1ng pilot ->\nMRC (siso/simo) | SFBC\
      \ ZF ch\xEDnh x\xE1c (alamouti) | MMSE (smux) -> quy\u1EBFt \u0111\u1ECBnh c\u1EE9\
      ng ->\ndescramble -> RS(248,216) -> CRC32 -> PDU tr\xEAn c\u1ED5ng 'pdus'.\n\
      In th\u1ED1ng k\xEA (ok / sig / rs / crc, SNR, EVM, cond H) khi d\u1EEBng.\n\
      \"\"\"\nimport os\nimport sys\nimport numpy as np\nfrom gnuradio import gr\n\
      \n\ndef _project_root():\n    \"\"\"Find the OFDM_N321_MIMO folder that contains\
      \ the ofdm321 package.\"\"\"\n    here = globals().get(\"__file__\")\n    candidates\
      \ = [os.environ.get(\"OFDM_N321_DIR\", \"\")]\n    if here:\n        d = os.path.dirname(os.path.abspath(here))\n\
      \        candidates += [d, os.path.dirname(d)]\n    candidates.append(os.path.expanduser(\"\
      ~/Desktop/OFDM_N321_MIMO\"))\n    for c in candidates:\n        if c and os.path.isfile(os.path.join(c,\
      \ \"ofdm321\", \"__init__.py\")):\n            c = os.path.abspath(c)\n    \
      \        if c not in sys.path:\n                sys.path.insert(0, c)\n    \
      \        return c\n    return None\n\n\ndef _settings(**kw):\n    from ofdm321.config\
      \ import load_settings\n    return load_settings(None, **kw)\n\n\ndef _missing(title,\
      \ in_sig, out_sig, msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321: \u0111\u1EB7t .grc trong OFDM_N321_MIMO/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c project>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\n\n\ndef _base():\n    if _project_root():\n\
      \        try:\n            from ofdm321.blocks import MimoRxSink as B\n    \
      \        return B\n        except Exception as exc:  # noqa: BLE001\n      \
      \      print(\"[E2] import l\u1ED7i:\", exc)\n    return _missing(\"MIMO RX\"\
      , [np.complex64, np.complex64], None, (), (\"pdus\",))\n\n\nclass blk(_base()):\n\
      \    \"\"\"MIMO OFDM RX.\"\"\"\n\n    def __init__(self, mimo_mode=\"alamouti\"\
      , modulation=\"qpsk\", sample_rate=1000000,\n                 sync_threshold=0.6):\n\
      \        super().__init__(_settings(mimo_mode=mimo_mode, modulation=modulation,\n\
      \                                   sample_rate=float(sample_rate), sync_threshold=float(sync_threshold)))\n\
      \n    def stop(self):\n        if hasattr(self, \"snapshot\"):\n           \
      \ print(\"[E2]\", self.snapshot())\n        return True\n"
    affinity: ''
    alias: ''
    comment: "[E2] \u0111\u1ED3ng b\u1ED9 + H 2x2 + MRC/SFBC/MMSE + RS + CRC"
    maxoutbuf: '0'
    mimo_mode: mimo_mode
    minoutbuf: '0'
    modulation: modulation
    sample_rate: samp_rate
    sync_threshold: '0.6'
  states:
    _io_cache: ('MIMO OFDM RX', 'blk', [('mimo_mode', "'alamouti'"), ('modulation',
      "'qpsk'"), ('sample_rate', '1000000'), ('sync_threshold', '0.6')], [('0', 'complex',
      1), ('1', 'complex', 1)], [('pdus', 'message', 1)], 'MIMO OFDM RX.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [460, 740]
    rotation: 0
    state: enabled
- name: e3_video
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E3] Video PDU receiver  (g\u1ED1c: ofdm321/blocks.py::VideoReceiver\
      \ = N210 v1.23 VideoReceiver r\xFAt g\u1ECDn)\n\nNh\u1EADn g\xF3i \u0111\xE3\
      \ qua CRC32, gom nh\xF3m 8 DATA + 8 RS8_PARITY, ch\u1EC9 giao DATA khi c\xF3\
      \ >= k+2 shard v\xE0\nparity d\u01B0 kh\u1EDBp; ghi TS theo th\u1EE9 t\u1EF1\
      \ ra out_path v\xE0 g\u1EEDi UDP 127.0.0.1:udp_port\n(xem: ffplay -fflags nobuffer\
      \ udp://127.0.0.1:5002). session ph\u1EA3i tr\xF9ng [E1].\n\"\"\"\nimport os\n\
      import sys\nimport numpy as np\nfrom gnuradio import gr\n\n\ndef _project_root():\n\
      \    \"\"\"Find the OFDM_N321_MIMO folder that contains the ofdm321 package.\"\
      \"\"\n    here = globals().get(\"__file__\")\n    candidates = [os.environ.get(\"\
      OFDM_N321_DIR\", \"\")]\n    if here:\n        d = os.path.dirname(os.path.abspath(here))\n\
      \        candidates += [d, os.path.dirname(d)]\n    candidates.append(os.path.expanduser(\"\
      ~/Desktop/OFDM_N321_MIMO\"))\n    for c in candidates:\n        if c and os.path.isfile(os.path.join(c,\
      \ \"ofdm321\", \"__init__.py\")):\n            c = os.path.abspath(c)\n    \
      \        if c not in sys.path:\n                sys.path.insert(0, c)\n    \
      \        return c\n    return None\n\n\ndef _settings(**kw):\n    from ofdm321.config\
      \ import load_settings\n    return load_settings(None, **kw)\n\n\ndef _missing(title,\
      \ in_sig, out_sig, msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321: \u0111\u1EB7t .grc trong OFDM_N321_MIMO/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c project>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\n\n\ndef _base():\n    if _project_root():\n\
      \        try:\n            from ofdm321.blocks import VideoReceiver as B\n \
      \           return B\n        except Exception as exc:  # noqa: BLE001\n   \
      \         print(\"[E3] import l\u1ED7i:\", exc)\n    return _missing(\"Video\
      \ receiver\", None, None, (\"pdus\",), ())\n\n\nclass blk(_base()):\n    \"\"\
      \"B\u1ED9 thu video (RS8+8 c\xF3 ki\u1EC3m ch\u1EE9ng).\"\"\"\n\n    def __init__(self,\
      \ session=0x4E333231, out_path=\"/tmp/ofdm_n321_rx.ts\", udp_port=5002):\n \
      \       super().__init__(int(session), os.path.expanduser(out_path), int(udp_port))\n\
      \n    def stop(self):\n        if hasattr(self, \"state\"):\n            s =\
      \ self.snapshot()\n            print(\"[E3] DATA\", s.get(\"data_packets\"),\
      \ \"missing\", s.get(\"missing_data_packets\"),\n                  \"END\",\
      \ s.get(\"end_received\"))\n            self.close()\n        return True\n"
    affinity: ''
    alias: ''
    comment: '[E3] RS8+8 -> TS + UDP'
    maxoutbuf: '0'
    minoutbuf: '0'
    out_path: rx_ts_path
    session: session
    udp_port: udp_port
  states:
    _io_cache: "('Video PDU receiver', 'blk', [('session', '1311978033'), ('out_path',\
      \ \"'/tmp/ofdm_n321_rx.ts'\"), ('udp_port', '5002')], [('pdus', 'message', 1)],\
      \ [], 'B\u1ED9 thu video (RS8+8 c\xF3 ki\u1EC3m ch\u1EE9ng).', [])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 740]
    rotation: 0
    state: enabled
- name: e4_channel
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E4] 2x2 channel simulator  (g\u1ED1c: ofdm321/blocks.py::MimoChannelSim)\
      \ \u2014 ch\u1EC9 d\xF9ng khi m\xF4 ph\u1ECFng.\n\ny = H x + H2 x[n-3] + AWGN,\
      \ nh\xE2n e^{j2\u03C0 f n}. channel: identity | fixed | rayleigh (seed c\u1ED1\
      \ \u0111\u1ECBnh).\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\n\ndef _project_root():\n    \"\"\"Find the OFDM_N321_MIMO\
      \ folder that contains the ofdm321 package.\"\"\"\n    here = globals().get(\"\
      __file__\")\n    candidates = [os.environ.get(\"OFDM_N321_DIR\", \"\")]\n  \
      \  if here:\n        d = os.path.dirname(os.path.abspath(here))\n        candidates\
      \ += [d, os.path.dirname(d)]\n    candidates.append(os.path.expanduser(\"~/Desktop/OFDM_N321_MIMO\"\
      ))\n    for c in candidates:\n        if c and os.path.isfile(os.path.join(c,\
      \ \"ofdm321\", \"__init__.py\")):\n            c = os.path.abspath(c)\n    \
      \        if c not in sys.path:\n                sys.path.insert(0, c)\n    \
      \        return c\n    return None\n\n\ndef _settings(**kw):\n    from ofdm321.config\
      \ import load_settings\n    return load_settings(None, **kw)\n\n\ndef _missing(title,\
      \ in_sig, out_sig, msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321: \u0111\u1EB7t .grc trong OFDM_N321_MIMO/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c project>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\n\n\ndef _base():\n    if _project_root():\n\
      \        try:\n            from ofdm321.blocks import MimoChannelSim as B\n\
      \            return B\n        except Exception as exc:  # noqa: BLE001\n  \
      \          print(\"[E4] import l\u1ED7i:\", exc)\n    return _missing(\"2x2\
      \ channel\", [np.complex64, np.complex64], [np.complex64, np.complex64])\n\n\
      \nclass blk(_base()):\n    \"\"\"K\xEAnh 2x2 m\xF4 ph\u1ECFng.\"\"\"\n\n   \
      \ def __init__(self, channel=\"rayleigh\", snr_db=20.0, cfo_hz=300.0, sample_rate=1000000,\
      \ tx_rms=0.1):\n        super().__init__(_settings(sim_channel=channel, sim_snr_db=float(snr_db),\
      \ sim_cfo_hz=float(cfo_hz),\n                                   sample_rate=float(sample_rate),\
      \ tx_rms=float(tx_rms)))\n"
    affinity: ''
    alias: ''
    cfo_hz: '300.0'
    channel: '''rayleigh'''
    comment: '[E4] SIM 2x2'
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: samp_rate
    snr_db: '20.0'
    tx_rms: tx_rms
  states:
    _io_cache: "('2x2 channel simulator', 'blk', [('channel', \"'rayleigh'\"), ('snr_db',\
      \ '20.0'), ('cfo_hz', '300.0'), ('sample_rate', '1000000'), ('tx_rms', '0.1')],\
      \ [('0', 'complex', 1), ('1', 'complex', 1)], [('0', 'complex', 1), ('1', 'complex',\
      \ 1)], 'K\xEAnh 2x2 m\xF4 ph\u1ECFng.', ['snr_db', 'tx_rms'])"
