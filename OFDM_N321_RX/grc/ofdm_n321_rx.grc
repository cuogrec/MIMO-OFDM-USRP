    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ofdm_n321_rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "N321 #2 - m\xE1y thu OFDM 2x2 MIMO"
    window_size: (1300,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 60]
    rotation: 0
    state: enabled

