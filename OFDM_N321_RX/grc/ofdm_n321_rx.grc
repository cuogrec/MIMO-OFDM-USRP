- name: e2_rx
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E2] MIMO OFDM RX  (g\u1ED1c: ofdm321/blocks.py::MimoRxSink\
      \ + modem.Demodulator)\n\n2 \u0111\u1EA7u v\xE0o = RX2 c\u1EE7a A:0 v\xE0 B:0.\
      \ Ring buffer; Schmidl-Cox g\u1ED9p 2 anten (metric chu\u1EA9n ho\xE1\nCauchy-Schwarz)\
      \ -> kho\xE1 khung -> tracking, gi\u1EA3i \u0111i\u1EC1u ch\u1EBF theo l\xF4\
      \ t\u1ED1i \u0111a 16 khung:\nb\xF9 CFO -> FFT -> H(k) 2x2 t\u1EEB LTF ma tr\u1EAD\
      n P -> SIG (CRC16, ki\u1EC3u interleaver) -> b\xF9 pha chung\nb\u1EB1ng pilot\
      \ -> MRC (siso/simo) | SFBC ZF ch\xEDnh x\xE1c (alamouti) | MMSE (smux) -> DE-INTERLEAVE\
      \ ->\nquy\u1EBFt \u0111\u1ECBnh + \u0111\u1ED9 tin c\u1EADy (kho\u1EA3ng c\xE1\
      ch bi\xEAn x SNR sau c\xE2n b\u1EB1ng, h\u1EA1 khi c\xF3 nhi\u1EC5u xung) ->\n\
      descramble -> RS(248,216); n\u1EBFu th\u1EA5t b\u1EA1i: GI\u1EA2I M\u1EC0M xo\xE1\
      \ d\u1EA7n byte k\xE9m tin c\u1EADy (\u226432 erasure,\nt\u1ED1i \u0111a 30%\
      \ th\u1EDDi gian th\u1EF1c) -> CRC32 -> PDU tr\xEAn c\u1ED5ng 'pdus'.\nCH\xD2\
      M SAO: c\u1ED5ng message 'const' xu\u1EA5t k\xFD hi\u1EC7u d\u1EEF li\u1EC7\
      u SAU C\xC2N B\u1EB0NG (sau MRC/SFBC/MMSE v\xE0 b\xF9 pha\npilot, tr\u01B0\u1EDB\
      c khi quy\u1EBFt \u0111\u1ECBnh bit) c\u1EE7a 1 khung t\u1ED1t m\u1ED7i const_every\
      \ khung, d\u1EA1ng PDU c32\n(QPSK 992 \u0111i\u1EC3m, 16QAM 496 \u0111i\u1EC3\
      m; smux g\u1ED3m c\u1EA3 2 lu\u1ED3ng). N\u1ED1i: 'const' -> PDU to Tagged Stream\n\
      (complex) -> QT GUI Constellation Sink. const_every=0 t\u1EAFt. \u0110\xE1m\
      \ \u0111i\u1EC3m tr\xF2n, g\u1ECDn = k\xEAnh t\u1ED1t;\nxoay = pha ch\u01B0\
      a b\xF9; nho\xE8 th\xE0nh v\xF2ng = CFO/SFO l\u1EDBn; t\xE1ch \u0111\xF4i =\
      \ sai k\xEAnh H.\nHai N321 c\xF3 clock ri\xEAng: CFO, l\u1EC7ch clock (SFO)\
      \ v\xE0 pha \u0111\u01B0\u1EE3c b\xF9 tr\xEAn t\u1EEBng khung.\nIn th\u1ED1\
      ng k\xEA (ok / soft / sig / rs / crc, SNR, EVM, cond H) khi d\u1EEBng.\n\"\"\
      \"\nimport os\nimport sys\nimport numpy as np\nfrom gnuradio import gr\n\n\n\
      def _project_root():\n    \"\"\"Find the OFDM_N321_MIMO folder that contains\
      \ the ofdm321 package.\"\"\"\n    here = globals().get(\"__file__\")\n    candidates\
      \ = [os.environ.get(\"OFDM_N321_DIR\", \"\")]\n    if here:\n        d = os.path.dirname(os.path.abspath(here))\n\
      \        up = os.path.dirname(d)\n        candidates += [d, up, os.path.join(up,\
      \ \"OFDM_N321_RX\"), os.path.join(up, \"OFDM_N321_TX\")]\n    home = os.path.expanduser(\"\
      ~/Desktop\")\n    candidates += [os.path.join(home, \"MIMO-OFDM-USRP-main\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"MIMO-OFDM-USRP\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"OFDM_N321_RX\"\
      ), os.path.join(home, \"OFDM_N321_MIMO\")]\n    for c in candidates:\n     \
      \   if c and os.path.isfile(os.path.join(c, \"ofdm321\", \"__init__.py\")):\n\
      \            c = os.path.abspath(c)\n            if c not in sys.path:\n   \
      \             sys.path.insert(0, c)\n            return c\n    return None\n\
      \n\ndef _settings(**kw):\n    from ofdm321.config import load_settings\n   \
      \ return load_settings(None, **kw)\n\n\ndef _missing(title, in_sig, out_sig,\
      \ msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321 (v0.2): \u0111\u1EB7t .grc trong MIMO-OFDM-USRP/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c OFDM_N321_RX>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\n\n\ndef _base():\n    if _project_root():\n\
      \        try:\n            from ofdm321.blocks import MimoRxSink as B\n    \
      \        return B\n        except Exception as exc:  # noqa: BLE001\n      \
      \      print(\"[E2] import l\u1ED7i:\", exc)\n    return _missing(\"MIMO RX\"\
      , [np.complex64, np.complex64], None, (), (\"pdus\", \"const\"))\n\n\nclass\
      \ blk(_base()):\n    \"\"\"MIMO OFDM RX.\"\"\"\n\n    def __init__(self, mimo_mode=\"\
      alamouti\", modulation=\"qpsk\", sample_rate=1000000,\n                 sync_threshold=0.6,\
      \ soft_decoding=True, const_every=8):\n        super().__init__(_settings(mimo_mode=mimo_mode,\
      \ modulation=modulation, soft_decoding=bool(soft_decoding),\n              \
      \                     const_every=int(const_every),\n                      \
      \             sample_rate=float(sample_rate), sync_threshold=float(sync_threshold)))\n\
      \n    def stop(self):\n        if hasattr(self, \"snapshot\"):\n           \
      \ print(\"[E2]\", self.snapshot())\n        return True\n"
    affinity: ''
    alias: ''
    comment: "[E2] \u0111\u1ED3ng b\u1ED9, H 2x2, MRC/SFBC/MMSE, de-interleave, gi\u1EA3\
      i m\u1EC1m RS, CRC"
    const_every: '8'
    maxoutbuf: '0'
    mimo_mode: mimo_mode
    minoutbuf: '0'
    modulation: modulation
    sample_rate: samp_rate
    soft_decoding: soft_decoding
    sync_threshold: '0.6'
  states:
    _io_cache: ('MIMO OFDM RX', 'blk', [('mimo_mode', "'alamouti'"), ('modulation',
      "'qpsk'"), ('sample_rate', '1000000'), ('sync_threshold', '0.6'), ('soft_decoding',
      'True'), ('const_every', '8')], [('0', 'complex', 1), ('1', 'complex', 1)],
      [('const', 'message', 1), ('pdus', 'message', 1)], 'MIMO OFDM RX.', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [460, 440]
    rotation: 0
    state: enabled
- name: e3_video
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E3] Video PDU receiver  (g\u1ED1c: ofdm321/blocks.py::VideoReceiver\
      \ = N210 v1.23 VideoReceiver r\xFAt g\u1ECDn)\n\nNh\u1EADn g\xF3i \u0111\xE3\
      \ qua CRC32, gom nh\xF3m 8 DATA + 8 RS8_PARITY, ch\u1EC9 giao DATA khi c\xF3\
      \ >= k+2 shard v\xE0\nparity d\u01B0 kh\u1EDBp; ghi TS theo th\u1EE9 t\u1EF1\
      \ ra out_path v\xE0 g\u1EEDi UDP 127.0.0.1:udp_port\n(xem: ffplay -fflags nobuffer\
      \ udp://127.0.0.1:5002).\nsession = 0: t\u1EF1 b\xE1m session c\u1EE7a m\xE1\
      y ph\xE1t \u0111\u1EA7u ti\xEAn nghe \u0111\u01B0\u1EE3c (nh\u01B0 run_rx.py).\n\
      \"\"\"\nimport os\nimport sys\nimport numpy as np\nfrom gnuradio import gr\n\
      \n\ndef _project_root():\n    \"\"\"Find the OFDM_N321_MIMO folder that contains\
      \ the ofdm321 package.\"\"\"\n    here = globals().get(\"__file__\")\n    candidates\
      \ = [os.environ.get(\"OFDM_N321_DIR\", \"\")]\n    if here:\n        d = os.path.dirname(os.path.abspath(here))\n\
      \        up = os.path.dirname(d)\n        candidates += [d, up, os.path.join(up,\
      \ \"OFDM_N321_RX\"), os.path.join(up, \"OFDM_N321_TX\")]\n    home = os.path.expanduser(\"\
      ~/Desktop\")\n    candidates += [os.path.join(home, \"MIMO-OFDM-USRP-main\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"MIMO-OFDM-USRP\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"OFDM_N321_RX\"\
      ), os.path.join(home, \"OFDM_N321_MIMO\")]\n    for c in candidates:\n     \
      \   if c and os.path.isfile(os.path.join(c, \"ofdm321\", \"__init__.py\")):\n\
      \            c = os.path.abspath(c)\n            if c not in sys.path:\n   \
      \             sys.path.insert(0, c)\n            return c\n    return None\n\
      \n\ndef _settings(**kw):\n    from ofdm321.config import load_settings\n   \
      \ return load_settings(None, **kw)\n\n\ndef _missing(title, in_sig, out_sig,\
      \ msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321 (v0.2): \u0111\u1EB7t .grc trong MIMO-OFDM-USRP/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c OFDM_N321_RX>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\n\n\ndef _base():\n    if _project_root():\n\
      \        try:\n            from ofdm321.blocks import VideoReceiver as B\n \
      \           return B\n        except Exception as exc:  # noqa: BLE001\n   \
      \         print(\"[E3] import l\u1ED7i:\", exc)\n    return _missing(\"Video\
      \ receiver\", None, None, (\"pdus\",), ())\n\n\nclass blk(_base()):\n    \"\"\
      \"B\u1ED9 thu video (RS8+8 c\xF3 ki\u1EC3m ch\u1EE9ng).\"\"\"\n\n    def __init__(self,\
      \ session=0, out_path=\"/tmp/ofdm_n321_rx.ts\", udp_port=5002):\n        super().__init__(int(session)\
      \ or None, os.path.expanduser(out_path), int(udp_port))\n\n    def stop(self):\n\
      \        if hasattr(self, \"state\"):\n            s = self.snapshot()\n   \
      \         print(\"[E3] DATA\", s.get(\"data_packets\"), \"missing\", s.get(\"\
      missing_data_packets\"),\n                  \"END\", s.get(\"end_received\"\
      ))\n            self.close()\n        return True\n"
    affinity: ''
    alias: ''
    comment: "[E3] t\u1EF1 b\xE1m session; RS8+8 -> TS + UDP"
    maxoutbuf: '0'
    minoutbuf: '0'
    out_path: rx_ts_path
    session: '0'
    udp_port: udp_port
  states:
    _io_cache: "('Video PDU receiver', 'blk', [('session', '0'), ('out_path', \"'/tmp/ofdm_n321_rx.ts'\"\
      ), ('udp_port', '5002')], [('pdus', 'message', 1)], [], 'B\u1ED9 thu video (RS8+8\
      \ c\xF3 ki\u1EC3m ch\u1EE9ng).', ['session'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [820, 440]
    rotation: 0
    state: enabled
- name: e4_channel
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E4] 2x2 channel simulator  (g\u1ED1c: ofdm321/blocks.py::MimoChannelSim)\
      \ \u2014 ch\u1EC9 d\xF9ng khi m\xF4 ph\u1ECFng.\n\ny = H x + H2 x[n-3] + AWGN,\
      \ nh\xE2n e^{j2\u03C0 f n}. channel: identity | fixed | rayleigh (seed c\u1ED1\
      \ \u0111\u1ECBnh).\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\n\ndef _project_root():\n    \"\"\"Find the OFDM_N321_MIMO\
      \ folder that contains the ofdm321 package.\"\"\"\n    here = globals().get(\"\
      __file__\")\n    candidates = [os.environ.get(\"OFDM_N321_DIR\", \"\")]\n  \
      \  if here:\n        d = os.path.dirname(os.path.abspath(here))\n        up\
      \ = os.path.dirname(d)\n        candidates += [d, up, os.path.join(up, \"OFDM_N321_RX\"\
      ), os.path.join(up, \"OFDM_N321_TX\")]\n    home = os.path.expanduser(\"~/Desktop\"\
      )\n    candidates += [os.path.join(home, \"MIMO-OFDM-USRP-main\", \"OFDM_N321_RX\"\
      ),\n                   os.path.join(home, \"MIMO-OFDM-USRP\", \"OFDM_N321_RX\"\
      ),\n                   os.path.join(home, \"OFDM_N321_RX\"), os.path.join(home,\
      \ \"OFDM_N321_MIMO\")]\n    for c in candidates:\n        if c and os.path.isfile(os.path.join(c,\
      \ \"ofdm321\", \"__init__.py\")):\n            c = os.path.abspath(c)\n    \
      \        if c not in sys.path:\n                sys.path.insert(0, c)\n    \
      \        return c\n    return None\n\n\ndef _settings(**kw):\n    from ofdm321.config\
      \ import load_settings\n    return load_settings(None, **kw)\n\n\ndef _missing(title,\
      \ in_sig, out_sig, msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321 (v0.2): \u0111\u1EB7t .grc trong MIMO-OFDM-USRP/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c OFDM_N321_RX>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\n\n\ndef _base():\n    if _project_root():\n\
      \        try:\n            from ofdm321.blocks import MimoChannelSim as B\n\
      \            return B\n        except Exception as exc:  # noqa: BLE001\n  \
      \          print(\"[E4] import l\u1ED7i:\", exc)\n    return _missing(\"2x2\
      \ channel\", [np.complex64, np.complex64], [np.complex64, np.complex64])\n\n\
      \nclass blk(_base()):\n    \"\"\"K\xEAnh 2x2 m\xF4 ph\u1ECFng.\"\"\"\n\n   \
      \ def __init__(self, channel=\"rayleigh\", snr_db=20.0, cfo_hz=300.0, sample_rate=1000000,\
      \ tx_rms=0.1):\n        super().__init__(_settings(sim_channel=channel, sim_snr_db=float(snr_db),\
      \ sim_cfo_hz=float(cfo_hz),\n                                   sample_rate=float(sample_rate),\
      \ tx_rms=float(tx_rms)))\n"
    affinity: ''
    alias: ''
    cfo_hz: '2000.0'
    channel: '''rayleigh'''
    comment: "[E4] SIM: k\xEAnh 2x2 + CFO"
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: samp_rate
    snr_db: '20.0'
    tx_rms: '0.1'
  states:
    _io_cache: "('2x2 channel simulator', 'blk', [('channel', \"'rayleigh'\"), ('snr_db',\
      \ '20.0'), ('cfo_hz', '300.0'), ('sample_rate', '1000000'), ('tx_rms', '0.1')],\
      \ [('0', 'complex', 1), ('1', 'complex', 1)], [('0', 'complex', 1), ('1', 'complex',\
      \ 1)], 'K\xEAnh 2x2 m\xF4 ph\u1ECFng.', ['snr_db', 'tx_rms'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 720]
    rotation: 0
    state: disabled
- name: e5_sfo
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E5] L\u1EC7ch clock l\u1EA5y m\u1EABu gi\u1EEFa hai N321\
      \  (g\u1ED1c: ofdm321/blocks.py::SfoResampler) \u2014 ch\u1EC9 d\xF9ng khi m\xF4\
      \ ph\u1ECFng.\n\nM\u1EABu ra th\u1EE9 k l\u1EA5y t\u1EA1i th\u1EDDi \u0111i\u1EC3\
      m k\xB7(1 + ppm\xB71e-6) c\u1EE7a lu\u1ED3ng v\xE0o (n\u1ED9i suy tuy\u1EBF\
      n t\xEDnh, 2 k\xEAnh).\nHai N321 th\u1EADt kh\xF4ng chung reference n\xEAn l\u1EC7\
      ch v\xE0i ppm; kh\u1ED1i n\xE0y gi\u1EA3 l\u1EADp \u0111i\u1EC1u \u0111\xF3\
      .\n\"\"\"\nimport os\nimport sys\nimport numpy as np\nfrom gnuradio import gr\n\
      \n\ndef _project_root():\n    \"\"\"Find the OFDM_N321_MIMO folder that contains\
      \ the ofdm321 package.\"\"\"\n    here = globals().get(\"__file__\")\n    candidates\
      \ = [os.environ.get(\"OFDM_N321_DIR\", \"\")]\n    if here:\n        d = os.path.dirname(os.path.abspath(here))\n\
      \        up = os.path.dirname(d)\n        candidates += [d, up, os.path.join(up,\
      \ \"OFDM_N321_RX\"), os.path.join(up, \"OFDM_N321_TX\")]\n    home = os.path.expanduser(\"\
      ~/Desktop\")\n    candidates += [os.path.join(home, \"MIMO-OFDM-USRP-main\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"MIMO-OFDM-USRP\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"OFDM_N321_RX\"\
      ), os.path.join(home, \"OFDM_N321_MIMO\")]\n    for c in candidates:\n     \
      \   if c and os.path.isfile(os.path.join(c, \"ofdm321\", \"__init__.py\")):\n\
      \            c = os.path.abspath(c)\n            if c not in sys.path:\n   \
      \             sys.path.insert(0, c)\n            return c\n    return None\n\
      \n\ndef _settings(**kw):\n    from ofdm321.config import load_settings\n   \
      \ return load_settings(None, **kw)\n\n\ndef _missing(title, in_sig, out_sig,\
      \ msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321 (v0.2): \u0111\u1EB7t .grc trong MIMO-OFDM-USRP/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c OFDM_N321_RX>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\n\n\ndef _base():\n    if _project_root():\n\
      \        try:\n            from ofdm321.blocks import SfoResampler as B\n  \
      \          return B\n        except Exception as exc:  # noqa: BLE001\n    \
      \        print(\"[E5] import l\u1ED7i:\", exc)\n    return _missing(\"SFO resampler\"\
      , [np.complex64, np.complex64], [np.complex64, np.complex64])\n\n\nclass blk(_base()):\n\
      \    \"\"\"L\u1EC7ch clock l\u1EA5y m\u1EABu (m\xF4 ph\u1ECFng).\"\"\"\n\n \
      \   def __init__(self, ppm=5.0):\n        super().__init__(float(ppm))\n"
    affinity: ''
    alias: ''
    comment: "[E5] SIM: l\u1EC7ch clock"
    maxoutbuf: '0'
    minoutbuf: '0'
    ppm: '5.0'
  states:
    _io_cache: "('SFO resampler', 'blk', [('ppm', '5.0')], [('0', 'complex', 1), ('1',\
      \ 'complex', 1)], [('0', 'complex', 1), ('1', 'complex', 1)], 'L\u1EC7ch clock\
      \ l\u1EA5y m\u1EABu (m\xF4 ph\u1ECFng).', [])"
