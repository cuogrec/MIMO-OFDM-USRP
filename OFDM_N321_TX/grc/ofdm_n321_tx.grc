  id: blocks_interleave
  parameters:
    affinity: ''
    alias: ''
    blocksize: '1'
    comment: "SIM: gh\xE9p 2 k\xEAnh v\xE0o 1 lu\u1ED3ng"
    maxoutbuf: '0'
