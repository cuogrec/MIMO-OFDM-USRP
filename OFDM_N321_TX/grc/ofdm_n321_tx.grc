options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "MIMO-OFDM-USRP v0.2, m\xE1y ph\xE1t"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ofdm_n321_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "N321 #1 - m\xE1y ph\xE1t OFDM 2x2 MIMO"
    window_size: (1300,800)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 60]
    rotation: 0
    state: enabled

blocks:
- name: center_freq
  id: variable
  parameters:
    comment: "ph\u1EA3i tr\xF9ng m\xE1y kia"
    value: 915e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 100]
    rotation: 0
    state: enabled
- name: interleaver
  id: variable
  parameters:
    comment: "none|block|carrier - m\xE1y thu t\u1EF1 theo"
    value: '''block'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1200, 100]
    rotation: 0
    state: enabled
- name: mimo_mode
  id: variable
  parameters:
    comment: "tr\xF9ng m\xE1y kia"
    value: '''alamouti'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 100]
    rotation: 0
    state: enabled
- name: modulation
  id: variable
  parameters:
    comment: "tr\xF9ng m\xE1y kia"
    value: '''qpsk'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 100]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "tr\xF9ng m\xE1y kia"
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 100]
    rotation: 0
    state: enabled
- name: ts_path
  id: variable
  parameters:
    comment: "file .ts ho\u1EB7c FIFO; tr\u1ED1ng = ch\u1EC9 IDLE"
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 190]
    rotation: 0
    state: enabled
- name: tx_args
  id: variable
  parameters:
    comment: 'IP N321 #1'
    value: '''addr=192.168.180.3,master_clock_rate=200e6'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 190]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: "anten: t\u1ED1i \u0111a 30"
    value: '20'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 190]
    rotation: 0
    state: enabled
- name: tx_rms
  id: variable
  parameters:
    comment: "bi\xEAn \u0111\u1ED9 s\u1ED1 m\u1ED7i k\xEAnh"
    value: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 190]
    rotation: 0
    state: enabled
- name: zmq_addr
  id: variable
  parameters:
    comment: "ch\u1EC9 d\xF9ng khi m\xF4 ph\u1ECFng"
    value: '''tcp://127.0.0.1:5560'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 100]
    rotation: 0
    state: enabled
- name: e1_tx
  id: epy_block
  parameters:
    _source_code: "\"\"\"[E1] MIMO OFDM TX source  (g\u1ED1c: ofdm321/blocks.py::MimoTxSource\
      \ + runner.py::Encoder)\n\n* \u0110\u1ECDc MPEG-TS t\u1EEB ts_path (file ho\u1EB7\
      c FIFO do FFmpeg ghi), c\u1EAFt 188 B, \u0111\xF3ng g\xF3i DATA (header 24 B\n\
      \  'OVN1', y h\u1EC7t N210 v1.23), sau m\u1ED7i 8 DATA th\xEAm 8 RS8_PARITY,\
      \ h\u1EBFt file th\xEC g\u1EEDi 12 END.\n* M\u1ED7i g\xF3i 212 B -> CRC32 ->\
      \ RS(248,216) -> scramble -> INTERLEAVER (block | carrier | none,\n  m\xE3 ki\u1EC3\
      u ghi v\xE0o SIG) -> QPSK/16QAM -> khung OFDM c\u1EE7a modem.Modulator:\n  STF\
      \ (CSD tr\xEAn TX1) + 2 LTF ma tr\u1EADn P + SIG (CRC16) + payload + 4 pilot;\
      \ siso/simo/alamouti/smux.\n* 2 \u0111\u1EA7u ra = 2 k\xEAnh TX (A:0, B:0).\
      \ C\xE1c ch\u1EBF \u0111\u1ED9 1 TX \u0111\u1EC3 k\xEAnh B b\u1EB1ng 0.\n* Khi\
      \ h\xE0ng \u0111\u1EE3i r\u1ED7ng: ph\xE1t khung IDLE d\u1EF1ng s\u1EB5n (lu\u1ED3\
      ng RF li\xEAn t\u1EE5c, g\u1EA7n nh\u01B0 kh\xF4ng t\u1ED1n CPU).\n* throttle=True\
      \ ch\u1EC9 d\xF9ng cho ch\u1EBF \u0111\u1ED9 m\xF4 ph\u1ECFng (kh\xF4ng c\xF3\
      \ UHD \u0111\u1EC3 \u0111i\u1EC1u nh\u1ECBp).\n\"\"\"\nimport os\nimport sys\n\
      import numpy as np\nfrom gnuradio import gr\n\n\ndef _project_root():\n    \"\
      \"\"Find the OFDM_N321_MIMO folder that contains the ofdm321 package.\"\"\"\n\
      \    here = globals().get(\"__file__\")\n    candidates = [os.environ.get(\"\
      OFDM_N321_DIR\", \"\")]\n    if here:\n        d = os.path.dirname(os.path.abspath(here))\n\
      \        up = os.path.dirname(d)\n        candidates += [d, up, os.path.join(up,\
      \ \"OFDM_N321_RX\"), os.path.join(up, \"OFDM_N321_TX\")]\n    home = os.path.expanduser(\"\
      ~/Desktop\")\n    candidates += [os.path.join(home, \"MIMO-OFDM-USRP-main\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"MIMO-OFDM-USRP\"\
      , \"OFDM_N321_RX\"),\n                   os.path.join(home, \"OFDM_N321_RX\"\
      ), os.path.join(home, \"OFDM_N321_MIMO\")]\n    for c in candidates:\n     \
      \   if c and os.path.isfile(os.path.join(c, \"ofdm321\", \"__init__.py\")):\n\
      \            c = os.path.abspath(c)\n            if c not in sys.path:\n   \
      \             sys.path.insert(0, c)\n            return c\n    return None\n\
      \n\ndef _settings(**kw):\n    from ofdm321.config import load_settings\n   \
      \ return load_settings(None, **kw)\n\n\ndef _missing(title, in_sig, out_sig,\
      \ msg_in=(), msg_out=()):\n    import pmt\n\n    class _Missing(gr.basic_block):\n\
      \        def __init__(self, *args, **kwargs):\n            gr.basic_block.__init__(self,\
      \ \"[THI\u1EBEU ofdm321] \" + title, in_sig, out_sig)\n            for name\
      \ in msg_in:\n                self.message_port_register_in(pmt.intern(name))\n\
      \            for name in msg_out:\n                self.message_port_register_out(pmt.intern(name))\n\
      \n        def start(self):\n            raise RuntimeError(\"Kh\xF4ng import\
      \ \u0111\u01B0\u1EE3c ofdm321 (v0.2): \u0111\u1EB7t .grc trong MIMO-OFDM-USRP/grc/\
      \ \"\n                               \"ho\u1EB7c export OFDM_N321_DIR=<th\u01B0\
      \ m\u1EE5c OFDM_N321_RX>\")\n\n        def general_work(self, input_items, output_items):\n\
      \            return 0\n    return _Missing\n\n\nimport threading\nimport time\n\
      \n\ndef _base():\n    if _project_root():\n        try:\n            from ofdm321.blocks\
      \ import MimoTxSource as B\n            return B\n        except Exception as\
      \ exc:  # noqa: BLE001\n            print(\"[E1] import l\u1ED7i:\", exc)\n\
      \    return _missing(\"MIMO TX source\", None, [np.complex64, np.complex64])\n\
      \n\nclass blk(_base()):\n    \"\"\"MIMO OFDM TX source + b\u1ED9 n\u1EA1p TS/FEC.\"\
      \"\"\n\n    def __init__(self, mimo_mode=\"alamouti\", modulation=\"qpsk\",\
      \ sample_rate=1000000,\n                 tx_rms=0.1, interleaver=\"block\",\
      \ session=0x4E333231, ts_path=\"\", throttle=False):\n        super().__init__(_settings(mimo_mode=mimo_mode,\
      \ modulation=modulation, interleaver=interleaver,\n                        \
      \           sample_rate=float(sample_rate), tx_rms=float(tx_rms)),\n       \
      \                  int(session), bool(throttle))\n        self.session_id, self.ts_path\
      \ = int(session), ts_path\n        self._stop = threading.Event()\n\n    def\
      \ start(self):\n        threading.Thread(target=self._feed, daemon=True).start()\n\
      \        return True\n\n    def stop(self):\n        self._stop.set()\n    \
      \    print(\"[E1]\", self.snapshot())\n        return True\n\n    def _feed(self):\n\
      \        from ofdm321 import protocol\n        from ofdm321.fec_rs import encode_parity\n\
      \        if not self.ts_path:\n            print(\"[E1] ts_path tr\u1ED1ng:\
      \ ch\u1EC9 ph\xE1t IDLE\")\n            return\n        seq, group = 0, []\n\
      \n        def parity(g):\n            for i, p in enumerate(encode_parity(g,\
      \ 8)):\n                self.enqueue(protocol.pack_packet(protocol.RS8_PARITY,\
      \ self.session_id, seq - len(g), p,\n                                      \
      \            protocol.rs_parity_stamp(len(g), i, 8)), self._stop)\n        with\
      \ open(os.path.expanduser(self.ts_path), \"rb\") as f:\n            while not\
      \ self._stop.is_set():\n                chunk = f.read(188)\n              \
      \  if len(chunk) < 188:\n                    break\n                self.enqueue(protocol.pack_packet(protocol.DATA,\
      \ self.session_id, seq, chunk,\n                                           \
      \       time.monotonic_ns()), self._stop)\n                seq += 1\n      \
      \          group.append(chunk)\n                if len(group) == 8:\n      \
      \              parity(group)\n                    group = []\n        if group:\n\
      \            parity(group)\n        for _ in range(12):\n            self.enqueue(protocol.pack_packet(protocol.END,\
      \ self.session_id, seq), self._stop)\n        print(\"[E1] \u0111\xE3 n\u1EA1\
      p h\u1EBFt TS, DATA =\", seq)\n"
    affinity: ''
    alias: ''
    comment: "[E1] g\xF3i -> FEC -> interleaver -> khung OFDM 2x2"
    interleaver: interleaver
    maxoutbuf: '0'
    mimo_mode: mimo_mode
    minoutbuf: '0'
    modulation: modulation
    sample_rate: samp_rate
    session: '0x4E333231'
    throttle: 'False'
    ts_path: ts_path
    tx_rms: tx_rms
  states:
    _io_cache: "('MIMO OFDM TX source', 'blk', [('mimo_mode', \"'alamouti'\"), ('modulation',\
      \ \"'qpsk'\"), ('sample_rate', '1000000'), ('tx_rms', '0.1'), ('interleaver',\
      \ \"'block'\"), ('session', '1311978033'), ('ts_path', \"''\"), ('throttle',\
      \ 'False')], [], [('0', 'complex', 1), ('1', 'complex', 1)], 'MIMO OFDM TX source\
      \ + b\u1ED9 n\u1EA1p TS/FEC.', ['throttle', 'ts_path'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 420]
    rotation: 0
    state: enabled
- name: note_chain
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "TS (ts_path) -> g\xF3i 212 B OVN1 + RS8+8 + END -> CRC32 -> RS(248,216)\
      \ -> scramble -> interleaver (m\xE3 ghi v\xE0o SIG) -> QPSK/16QAM -> khung OFDM\
      \ 2x2: STF+CSD, 2 LTF ma tr\u1EADn P, SIG CRC16, payload + 4 pilot -> UHD sink\
      \ 2 k\xEAnh. H\xE0ng \u0111\u1EE3i r\u1ED7ng -> khung IDLE."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 330]
    rotation: 0
    state: enabled
- name: note_overview
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "M\xC1Y PH\xC1T - USRP N321 #1 (folder OFDM_N321_TX). Ph\xE1t video OFDM\
      \ 2x2 MIMO tr\xEAn TX/RX A:0 v\xE0 B:0, 915 MHz, 1 MS/s. M\xE1y thu d\xF9ng\
      \ ofdm_n321_rx.grc trong folder OFDM_N321_RX, ch\u1EA1y TR\u01AF\u1EDAC. Hai\
      \ m\xE1y ph\u1EA3i c\xF9ng samp_rate, center_freq, mimo_mode, modulation. [E1]\
      \ l\xE0 Embedded Python g\u1ECDi g\xF3i ofdm321 c\u1EE7a folder n\xE0y (\u0111\
      \u1EB7t .grc trong OFDM_N321_TX/grc/). Ch\u1EA1y ch\xEDnh th\u1EE9c: scripts/start_tx.sh."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
- name: note_sim
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "M\xD4 PH\u1ECENG: disable UHD Sink, enable Interleave + ZMQ PUSH, \u0111\
      \u1EB7t throttle=True \u1EDF [E1]. M\xE1y thu (ofdm_n321_rx.grc, ch\u1EBF \u0111\
      \u1ED9 m\xF4 ph\u1ECFng) k\xE9o m\u1EABu t\u1EEB zmq_addr; ch\u1EA1y m\xE1y\
      \ thu tr\u01B0\u1EDBc."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [900, 420]
    rotation: 0
    state: enabled
